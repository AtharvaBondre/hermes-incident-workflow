{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/hermes-incident-workflow/workflow.schema.json",
  "title": "Trusted workflow policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "evidence", "validation", "hermes", "limits"],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "allowed_services", "allowed_environments", "allowed_patch_prefixes"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "allowed_services": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed_environments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed_patch_prefixes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/$"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_window_minutes", "maximum_log_records", "maximum_database_rows", "allowed_database_views"],
      "properties": {
        "maximum_window_minutes": {"type": "integer", "minimum": 1, "maximum": 60},
        "maximum_log_records": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maximum_database_rows": {"type": "integer", "minimum": 1, "maximum": 1000},
        "allowed_database_views": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"}}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_test_argv"],
      "properties": {
        "required_test_argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"type": "string", "minLength": 1, "maxLength": 200}
        }
      }
    },
    "hermes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "skill", "maximum_attempt_seconds"],
      "properties": {
        "profile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
        "skill": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
        "maximum_attempt_seconds": {"type": "integer", "minimum": 1, "maximum": 900}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_maximum_attempts", "hard_maximum_remediation_seconds"],
      "properties": {
        "hard_maximum_attempts": {"type": "integer", "minimum": 1, "maximum": 5},
        "hard_maximum_remediation_seconds": {"type": "integer", "minimum": 1, "maximum": 1500}
      }
    }
  }
}
